# Copy this file to .env to override defaults locally.

WEB_BASE_URL=https://www.saucedemo.com
API_BASE_URL=https://jsonplaceholder.typicode.com

# SauceDemo standard test credentials (public, documented on the site itself)
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# "chrome" or "firefox"
BROWSER=chrome
HEADLESS=true
